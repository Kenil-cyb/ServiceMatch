PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/servicematch
# Generate a cryptographically secure 256-bit secret outside the application:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_cryptographically_secure_random_string_at_least_32_chars
GEMINI_API_KEY=replace_with_gemini_api_key
